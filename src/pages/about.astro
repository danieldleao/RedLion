---
import Layout from "../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="About Specification // Red Lion Labs - Daniel Doro Leão"
  activePage="about"
>
  <div class="page-container container">
    <!-- Page Breadcrumb / Dimension Marker -->
    <div class="cad-dimension-line">
      <span>SPEC-DOC: RLL-PERS-01 // ARCHITECTURE & SOFTWARE RESUME</span>
    </div>

    <!-- Header Banner -->
    <div class="about-hero hud-panel cad-frame">
      <div class="hero-left">
        <div class="section-tag">
          <span>CURRICULUM VITAE // BIOGRAPHICAL SPEC</span>
        </div>
        <h1 class="about-name">DANIEL DORO LEÃO</h1>
        <p class="about-role">
          SOFTWARE DEVELOPER & PROGRAMMING DESIGNER // CAD-BIM SPECIALIST
        </p>

        <div class="quick-status-grid">
          <div class="status-item">
            <span class="lbl">LOCATION:</span>
            <span class="val">Ajax, Ontario, Canada</span>
          </div>
          <div class="status-item">
            <span class="lbl">STUDIES:</span>
            <span class="val highlight-yellow">Durham College (CPA 2028)</span>
