          src={`${baseUrl}/Img/rlHero.png`}
          alt="Daniel Doro Leão - Software Developer & Programming Designer"
          class="hero-profile-img"
        />
        <div class="cad-photo-overlay">
          <span class="photo-coord">[CAD-ID: DDL-2026]</span>
        </div>
      </div>
    </div>

    <!-- Section 1: Executive Summary -->
    <section class="about-section">
      <div class="section-header">
        <div class="section-tag">
          <span>SECTION 01 // OVERVIEW</span>
        </div>
        <h2>EXECUTIVE SUMMARY</h2>
      </div>

      <div class="summary-card hud-panel cad-frame">
        <p class="lead">
          "I am a software developer and programming designer with a strong
          foundation in programming principles, data structures, and algorithms.
          My background in architecture and design has honed my problem-solving
          skills, attention to detail, and ability to work collaboratively in
          multidisciplinary teams. I am passionate about creating efficient,
          scalable, and maintainable code while continuously learning new
          technologies and best practices."
        </p>
        <div class="summary-footer">
          <span
            >CORE PARADIGM: ARCHITECTURAL PRECISION ✕ COMPUTATIONAL LOGIC</span
          >
        </div>
      </div>
    </section>

    <!-- Section 2: Skills & Qualifications Matrix -->
    <section class="about-section">
      <div class="section-header">
        <div class="section-tag">
          <span>SECTION 02 // TECHNICAL MATRIX</span>
        </div>
        <h2>SKILLS & QUALIFICATIONS</h2>
      </div>

      <div class="skills-matrix-grid">
        <!-- Core Skills -->
        <div class="skills-card hud-panel cad-frame">
          <div class="skills-card-header">
            <span class="skills-icon">◆</span>
            <h3>CORE SKILLS</h3>
          </div>
          <ul class="skills-list">
            <li>Structured problem-solving and logical thinking</li>
            <li>Technical documentation and specification compliance</li>
            <li>Time management and task prioritization under deadlines</li>
            <li>Team collaboration across multidisciplinary environments</li>
            <li>
              Ability to follow defined processes, standards, and workflows
            </li>
            <li>
              Fast learner with experience transitioning between tools and
              systems
            </li>
            <li>Strong communication skills in English and Portuguese</li>
          </ul>
        </div>

