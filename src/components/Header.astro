---
interface Props {
  activePage?: "main" | "about" | "portfolio" | "contacts";
}

const { activePage = "main" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const mainHref = `${baseUrl}/`;
const aboutHref = `${baseUrl}/about`;
const portfolioHref = `${baseUrl}/portfolio`;
const contactsHref = `${baseUrl}/contacts`;
---

<header class="cad-header" id="main-header">
  <div class="header-inner container">
    <!-- Brand / Identity Unit -->
    <a href={mainHref} class="brand-unit" aria-label="Red Lion Labs Home">
      <div class="brand-logo-frame">
        <img
          src={`${baseUrl}/Img/RedLionLogo-OutLine.svg`}
          alt="Red Lion Labs Vector Logo"
          class="brand-lion-icon"
        />
      </div>
      <div class="brand-text-block">
        <span class="brand-title"
          ><span class="brand-red">RED LION</span>
          <span class="brand-white">LABS</span></span
        >
        <span class="brand-meta">SYS.V2.1 // RLL-INSTRUMENT</span>
      </div>
    </a>

    <!-- Center Desktop Navigation -->
    <nav class="cad-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li class="nav-item">
          <a
            href={mainHref}
            class:list={["nav-link", { active: activePage === "main" }]}
          >
            <span class="nav-num">01</span>
            <span class="nav-text">MAIN</span>
            {activePage === "main" && <span class="nav-indicator" />}
          </a>
        </li>
        <li class="nav-item">
          <a
            href={aboutHref}
            class:list={["nav-link", { active: activePage === "about" }]}
          >
            <span class="nav-num">02</span>
            <span class="nav-text">ABOUT</span>
            {activePage === "about" && <span class="nav-indicator" />}
          </a>
        </li>
        <li class="nav-item">
          <a
            href={portfolioHref}
            class:list={["nav-link", { active: activePage === "portfolio" }]}
          >
            <span class="nav-num">03</span>
            <span class="nav-text">PORTFOLIO</span>
            {activePage === "portfolio" && <span class="nav-indicator" />}
          </a>
        </li>
        <li class="nav-item">
          <a
            href={contactsHref}
            class:list={["nav-link", { active: activePage === "contacts" }]}
          >
            <span class="nav-num">04</span>
            <span class="nav-text">CONTACTS</span>
            {activePage === "contacts" && <span class="nav-indicator" />}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Right Instrument Controls -->
    <div class="header-controls">
      <!-- Live Status Pill -->
      <div class="status-box" title="System Telemetry">
        <span class="status-dot"></span>
        <span class="status-text">ONLINE</span>
      </div>

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle-btn"
        class="theme-toggle-btn"
        aria-label="Toggle Light/Dark Theme"
        title="Toggle Theme (Graphite / Ice White)"
      >
        <span class="theme-label-dark">DARK</span>
        <span class="theme-sep">/</span>
        <span class="theme-label-light">LIGHT</span>
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        aria-label="Open Mobile Menu"
        aria-expanded="false"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer / Diagnostics Panel -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <span class="drawer-title">DIAGNOSTIC NAV-PANEL</span>
      <span class="drawer-coords">COORD [43.8509° N, 79.0204° W]</span>
    </div>
    <ul class="mobile-nav-list">
      <li>
        <a
          href={mainHref}
          class:list={["mobile-nav-link", { active: activePage === "main" }]}
        >
          <span class="num">01</span>
          <span class="text">MAIN // INDEX</span>
        </a>
      </li>
      <li>
        <a
          href={aboutHref}
          class:list={["mobile-nav-link", { active: activePage === "about" }]}
        >
          <span class="num">02</span>
          <span class="text">ABOUT // SPECIFICATION</span>
        </a>
      </li>
      <li>
        <a
          href={portfolioHref}
          class:list={[
            "mobile-nav-link",
            { active: activePage === "portfolio" },
          ]}
        >
          <span class="num">03</span>
          <span class="text">PORTFOLIO // REPOSITORIES</span>
        </a>
      </li>
      <li>
        <a
          href={contactsHref}
          class:list={[
            "mobile-nav-link",
            { active: activePage === "contacts" },
          ]}
        >
          <span class="num">04</span>
          <span class="text">CONTACTS // TERMINAL</span>
        </a>
      </li>
    </ul>
    <div class="drawer-footer">
      <span>RED LION LABS // ALL SYSTEMS OPERATIONAL</span>
    </div>
  </div>
</header>

<style>
  .cad-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border-dim);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 1000;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  /* Brand */
  .brand-unit {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .brand-logo-frame {
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .brand-unit:hover .brand-logo-frame {
    filter: drop-shadow(0 0 10px rgba(250, 150, 0, 0.8));
    transform: scale(1.08);
  }

  .brand-lion-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(250, 0, 25, 0.6));
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .brand-red {
    color: var(--accent-primary, #fa0019);
  }

  .brand-white {
    color: #c8c8c8; /* Ice White */
  }

  [data-theme="light"] .brand-white {
    color: #191919; /* Graphite on light canvas */
  }

  .brand-meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent-secondary);
    letter-spacing: 0.1em;
  }

  /* Navigation */
  .cad-nav {
    display: none;
  }

  @media (min-width: 820px) {
    .cad-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    border: 1px solid transparent;
    position: relative;
    transition: all 0.2s ease;
  }

  .nav-num {
    font-size: 0.65rem;
    color: var(--accent-secondary);
    opacity: 0.75;
  }

  .nav-link:hover {
    color: var(--text-primary);
    border-color: var(--border-dim);
    background: rgba(250, 0, 25, 0.04);
  }

  .nav-link.active {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background: rgba(250, 0, 25, 0.08);
  }

  .nav-link.active .nav-num {
    color: var(--accent-primary);
    opacity: 1;
  }

  .nav-indicator {
    position: absolute;
    bottom: -1px;
    left: 20%;
    right: 20%;
    height: 2px;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
  }

  /* Controls */
  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-box {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-dim);
    background: rgba(0, 0, 0, 0.25);
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .status-box {
      display: flex;
    }
  }

  /* Theme Toggle */
  .theme-toggle-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border-strong);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    cursor: pointer;
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.2s ease;
  }

  .theme-toggle-btn:hover {
    border-color: var(--accent-secondary);
    box-shadow: var(--hud-yellow-glow);
  }

  [data-theme="dark"] .theme-label-dark {
    color: var(--accent-secondary);
    font-weight: bold;
  }

  [data-theme="dark"] .theme-label-light {
    opacity: 0.45;
  }

  [data-theme="light"] .theme-label-light {
    color: var(--accent-primary);
    font-weight: bold;
  }

  [data-theme="light"] .theme-label-dark {
    opacity: 0.45;
  }

  .theme-sep {
    opacity: 0.3;
  }

  /* Mobile Button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 36px;
    height: 36px;
    padding: 8px;
    background: transparent;
    border: 1px solid var(--border-dim);
    cursor: pointer;
  }

  @media (min-width: 820px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .menu-bar {
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100vw;
    background: var(--bg-card);
    border-bottom: 2px solid var(--accent-primary);
    padding: 1.5rem;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.7);
    z-index: 999;
  }

  .mobile-drawer.open {
    display: block;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-secondary);
    border-bottom: 1px solid var(--border-dim);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .mobile-nav-link .num {
    color: var(--accent-secondary);
    font-weight: bold;
  }

  .mobile-nav-link.active {
    border-color: var(--accent-primary);
    background: rgba(250, 0, 25, 0.1);
    color: var(--accent-primary);
  }

  .drawer-footer {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    text-align: center;
    border-top: 1px solid var(--border-dim);
    padding-top: 0.75rem;
  }
</style>

<script>
  // Theme Switching & Mobile Menu Logic
  function initHeaderControls() {
    const themeBtn = document.getElementById("theme-toggle-btn");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileDrawer = document.getElementById("mobile-drawer");

    // Theme Toggle
    if (themeBtn) {
      themeBtn.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme") || "dark";
        const nextTheme = currentTheme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", nextTheme);
        localStorage.setItem("rll-theme", nextTheme);
      });
    }

    // Mobile Menu Toggle
    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener("click", () => {
        const isOpen = mobileDrawer.classList.toggle("open");
        mobileBtn.setAttribute("aria-expanded", String(isOpen));
        mobileDrawer.setAttribute("aria-hidden", String(!isOpen));
      });

      // Close on link click
      mobileDrawer.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileDrawer.classList.remove("open");
          mobileBtn.setAttribute("aria-expanded", "false");
          mobileDrawer.setAttribute("aria-hidden", "true");
        });
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderControls);
  } else {
    initHeaderControls();
  }
</script>
