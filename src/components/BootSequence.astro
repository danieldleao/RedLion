        <!-- Dynamic Lion Eyes with High Voltage Intensity -->
        <g class="circuit-eyes-layer">
          <polygon class="circuit-eye left" points="406.29 436.3 326.12 436.3 382.81 493 422.9 493 439.5 509.6 439.5 469.51 406.29 436.3"/>
          <polygon class="circuit-eye right" points="586.1 436.3 666.28 436.3 609.58 493 569.49 493 552.89 509.6 552.89 469.51 586.1 436.3"/>
