    </div>

    <!-- HUD Telemetry Readout & Progress Panel -->
    <div class="boot-telemetry-hud">
      <div class="boot-brand-line">
        <span class="hud-brand-title">RED LION <span class="hud-brand-sub">LABS</span></span>
        <span class="hud-brand-spec">SYS.V2.1 // QUANTUM_STARTUP</span>
      </div>

      <!-- Real-time Diagnostic Log -->
      <div class="boot-terminal-stream" id="boot-log">
        <span class="log-cursor">></span> <span class="log-text" id="boot-log-text">ENERGIZING QUANTUM CIRCUIT NODES...</span>
      </div>

      <!-- High Voltage Progress Gauge -->
      <div class="boot-gauge-container">
        <div class="boot-gauge-bar" id="boot-progress"></div>
        <div class="boot-gauge-marker"></div>
      </div>

      <div class="boot-gauge-meta">
        <span class="meta-energy" id="boot-voltage-text">BUS VOLTAGE: 480.0 V</span>
        <span class="meta-pct" id="boot-pct-text">000%</span>
      </div>
    </div>

    <!-- Accessible Skip Trigger -->
    <button class="boot-skip-btn" id="boot-skip-btn" aria-label="Skip Intro Animation">
      <span>[ SKIP SEQUENCE // ESC ]</span>
