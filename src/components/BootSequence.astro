        <!-- Dynamic Energy Surge Traces Overlay -->
        <g class="circuit-surge-layer">
          <polygon class="circuit-pulse" points="533.44 849.76 581.24 801.96 581.24 761.87 637.93 705.18 637.93 665.09 722.97 580.05 722.97 392.19 613.61 282.83 539.13 282.83 496.2 325.77 453.26 282.83 378.78 282.83 269.43 392.19 269.43 580.05 354.46 665.09 354.46 705.18 411.16 761.87 411.16 801.96 458.96 849.76 533.44 849.76"/>
