---
// High-Impact Screen-Size Startup Boot Presentation & Circuit Energy Sequence
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="boot-sequence" class="boot-overlay" aria-label="System Boot Sequence">
  <!-- Background High-Voltage Electrical Spark Canvas -->
  <canvas id="boot-sparks-canvas" class="boot-sparks-canvas"></canvas>

  <!-- Central High-Impact CAD Stage -->
  <div class="boot-stage">
    <!-- Ambient CAD Coordinate Framing -->
    <div class="boot-cad-brackets">
      <span class="cad-coord-tl">SYS_INIT // 43.8509° N, 79.0204° W</span>
      <span class="cad-coord-tr">PROTOCOL: QUANTUM_CIRCUIT_v2.1</span>
      <span class="cad-coord-bl">VOLTAGE: 480V // 3-PHASE</span>
      <span class="cad-coord-br">STATE: CALIBRATING_NODES</span>
    </div>

    <!-- Outer Rotating CAD Reticle Rings -->
    <div class="boot-reticle" aria-hidden="true">
      <div class="reticle-ring-outer"></div>
      <div class="reticle-ring-mid"></div>
      <div class="reticle-ring-inner"></div>
      <div class="reticle-crosshair-h"></div>
      <div class="reticle-crosshair-v"></div>
    </div>

    <!-- Screen-Size Vector Circuit Lion -->
    <div class="boot-logo-container">
      <svg id="boot-circuit-svg" class="boot-circuit-svg" viewBox="0 0 992.13 1133.86" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="energyGlow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter id="hyperPulse" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="14" result="bigGlow" />
            <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="coreGlow" />
            <feMerge>
              <feMergeNode in="bigGlow" />
              <feMergeNode in="coreGlow" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <linearGradient id="energyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FA0019" />
            <stop offset="50%" stop-color="#FA9600" />
            <stop offset="100%" stop-color="#FFFFFF" />
          </linearGradient>
        </defs>

        <!-- Base Circuit Traces Group -->
        <g class="circuit-base-layer">
          <polygon class="circuit-trace thick" points="533.44 849.76 581.24 801.96 581.24 761.87 637.93 705.18 637.93 665.09 722.97 580.05 722.97 392.19 613.61 282.83 539.13 282.83 496.2 325.77 453.26 282.83 378.78 282.83 269.43 392.19 269.43 580.05 354.46 665.09 354.46 705.18 411.16 761.87 411.16 801.96 458.96 849.76 533.44 849.76"/>
