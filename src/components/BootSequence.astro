<style>
  .boot-overlay {
    position: fixed;
    inset: 0;
    background: #080808;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s ease;
    will-change: opacity, transform;
  }

  .boot-overlay.is-finished {
    opacity: 0;
    transform: scale(1.04);
    visibility: hidden;
    pointer-events: none;
  }

  .boot-sparks-canvas {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }

  .boot-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    height: 100%;
    padding: clamp(1rem, 3vw, 2rem);
    user-select: none;
  }

  /* CAD Corner Coordinate Labels */
  .boot-cad-brackets {
    position: absolute;
    inset: 1.5rem;
    pointer-events: none;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: rgba(250, 150, 0, 0.4);
    letter-spacing: 0.1em;
    display: none;
  }

  @media (min-width: 768px) {
    .boot-cad-brackets {
      display: block;
    }
  }

  .cad-coord-tl { position: absolute; top: 0; left: 0; }
  .cad-coord-tr { position: absolute; top: 0; right: 0; }
  .cad-coord-bl { position: absolute; bottom: 0; left: 0; }
  .cad-coord-br { position: absolute; bottom: 0; right: 0; }

  /* Rotating Reticle Rings Framing Logo */
  .boot-reticle {
    position: absolute;
    width: min(88vw, 76vh);
    height: min(88vw, 76vh);
    max-width: 740px;
    max-height: 740px;
    pointer-events: none;
    z-index: 2;
  }

  .reticle-ring-outer {
    position: absolute;
    inset: 0;
    border: 1px dashed rgba(250, 0, 25, 0.3);
    border-radius: 50%;
    animation: rotateClockwise 16s linear infinite;
  }

  .reticle-ring-mid {
    position: absolute;
    inset: 40px;
    border: 1px solid rgba(250, 150, 0, 0.2);
    border-radius: 50%;
    animation: rotateCounter 10s linear infinite;
  }

  .reticle-ring-inner {
    position: absolute;
    inset: 90px;
    border: 1px dotted rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    animation: rotateClockwise 6s linear infinite;
  }

  .reticle-crosshair-h {
    position: absolute;
    top: 50%;
    left: -40px;
    right: -40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(250, 0, 25, 0.3), rgba(250, 150, 0, 0.4), rgba(250, 0, 25, 0.3), transparent);
  }

  .reticle-crosshair-v {
    position: absolute;
    left: 50%;
    top: -40px;
    bottom: -40px;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(250, 0, 25, 0.3), rgba(250, 150, 0, 0.4), rgba(250, 0, 25, 0.3), transparent);
  }

  @keyframes rotateClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotateCounter {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  /* Screen Size Vector Circuit Stage */
  .boot-logo-container {
    position: relative;
    z-index: 5;
    width: min(85vw, 68vh);
    height: min(85vw, 68vh);
    max-width: 620px;
    max-height: 620px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 35px rgba(250, 0, 25, 0.4));
  }

  .boot-circuit-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Circuit Trace Base Lines */
  .circuit-trace {
    stroke: #FA0019;
    stroke-miterlimit: 10;
    fill: none;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: drawCircuitTraces 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .circuit-trace.thick {
    stroke-width: 13px;
  }

  .circuit-trace.thin {
    stroke-width: 7px;
  }

  /* Circuit Energy Pulse Layer - Traveling Electric Current */
  .circuit-pulse {
    stroke: #FA9600;
    stroke-width: 14px;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 60 280;
    stroke-dashoffset: 800;
    filter: url(#energyGlow);
    animation: energySurgeLoop 1.6s cubic-bezier(0.2, 0.8, 0.4, 1) infinite;
  }

  @keyframes energySurgeLoop {
    0% {
      stroke-dashoffset: 800;
      stroke: #FA0019;
      opacity: 0.6;
    }
    50% {
      stroke: #FFFFFF;
      opacity: 1;
      filter: drop-shadow(0 0 12px #FA9600) drop-shadow(0 0 24px #FA0019);
    }
    100% {
      stroke-dashoffset: 0;
      stroke: #FA9600;
      opacity: 0.8;
    }
  }

  @keyframes drawCircuitTraces {
    0% {
      stroke-dashoffset: 600;
      opacity: 0.2;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* Lion Eyes & Nose High Voltage Core */
  .circuit-eye {
    fill: #FA0019;
    stroke: #FA9600;
    stroke-width: 4px;
    filter: url(#hyperPulse);
    animation: eyeCharge 1.4s ease-in-out infinite alternate;
  }

  .circuit-nose {
    fill: #FA0019;
    stroke: #FA0019;
    stroke-width: 5px;
    animation: nosePulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes eyeCharge {
    0% {
      fill: #7D0019;
      stroke: #FA0019;
      filter: drop-shadow(0 0 8px #FA0019);
    }
    100% {
      fill: #FA9600;
      stroke: #FFFFFF;
      filter: drop-shadow(0 0 20px #FA9600) drop-shadow(0 0 35px #FA0019);
    }
  }

  @keyframes nosePulse {
    0% { fill: #FA0019; }
    100% { fill: #FA9600; filter: drop-shadow(0 0 14px #FA9600); }
  }

  /* Circuit Terminal Nodes */
  .circuit-node {
    fill: #FA0019;
    stroke: #FA9600;
    stroke-width: 4px;
    transform-origin: center;
    animation: nodePulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes nodePulse {
    0% {
      transform: scale(0.92);
      fill: #FA0019;
      stroke: rgba(250, 150, 0, 0.4);
    }
    50% {
      fill: #FA9600;
      stroke: #FFFFFF;
    }
    100% {
      transform: scale(1.12);
      fill: #FFFFFF;
      stroke: #FA0019;
      filter: drop-shadow(0 0 10px #FA9600) drop-shadow(0 0 18px #FA0019);
    }
  }

  /* HUD Telemetry Readout */
  .boot-telemetry-hud {
    position: relative;
    z-index: 6;
    width: 100%;
    max-width: 520px;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(14, 14, 14, 0.85);
    border: 1px solid rgba(250, 0, 25, 0.35);
    padding: 1rem 1.4rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(250, 0, 25, 0.2);
  }

  .boot-brand-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hud-brand-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: #FA0019;
    letter-spacing: 0.1em;
  }

  .hud-brand-sub {
    color: #FA9600;
  }

  .hud-brand-spec {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: rgba(200, 200, 200, 0.7);
    letter-spacing: 0.08em;
  }

  .boot-terminal-stream {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: #FA9600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.05em;
  }

  .log-cursor {
    color: #FA0019;
    font-weight: bold;
    animation: blinkCursor 0.8s infinite;
  }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .boot-gauge-container {
    width: 100%;
    height: 5px;
    background: rgba(40, 40, 40, 0.8);
    border: 1px solid rgba(250, 0, 25, 0.4);
    position: relative;
    overflow: hidden;
  }

  .boot-gauge-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #FA0019 0%, #FA9600 70%, #FFFFFF 100%);
    box-shadow: 0 0 12px #FA0019, 0 0 20px #FA9600;
    transition: width 0.08s linear;
  }

  .boot-gauge-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: rgba(200, 200, 200, 0.6);
  }

  .meta-energy {
    color: #FA9600;
  }

  .meta-pct {
    color: #FFFFFF;
    font-weight: bold;
  }

  /* Skip Button */
  .boot-skip-btn {
    position: relative;
    z-index: 7;
    margin-top: 1rem;
    background: transparent;
    border: 1px solid rgba(200, 200, 200, 0.25);
    color: rgba(200, 200, 200, 0.65);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    padding: 0.4rem 1rem;
    cursor: pointer;
    letter-spacing: 0.1em;
    transition: all 0.2s ease;
  }

  .boot-skip-btn:hover {
    color: #FA9600;
    border-color: #FA9600;
    box-shadow: 0 0 12px rgba(250, 150, 0, 0.4);
    background: rgba(250, 150, 0, 0.08);
  }
</style>

<script>
  function runBootSequence() {
    const overlay = document.getElementById('boot-sequence');
    const logText = document.getElementById('boot-log-text');
    const progressBar = document.getElementById('boot-progress');
    const pctText = document.getElementById('boot-pct-text');
    const voltText = document.getElementById('boot-voltage-text');
    const skipBtn = document.getElementById('boot-skip-btn');
    const sparksCanvas = document.getElementById('boot-sparks-canvas') as HTMLCanvasElement;
    const ctx = sparksCanvas?.getContext('2d');

    if (!overlay) return;

    // High Voltage Electrical Sparks Background Simulation
    interface Spark {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
      color: string;
      isLightning?: boolean;
      points?: { x: number; y: number }[];
    }

    const sparks: Spark[] = [];
    let isRunning = true;

    function resizeCanvas() {
      if (sparksCanvas) {
        sparksCanvas.width = window.innerWidth;
        sparksCanvas.height = window.innerHeight;
      }
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    function emitBackgroundSparks() {
      if (!isRunning) return;
      const colors = ['#FA0019', '#FA9600', '#FFFFFF', '#FFD277'];
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;

      // Random lightning discharge around perimeter or jumping inward
      if (Math.random() < 0.4) {
        const startAngle = Math.random() * Math.PI * 2;
        const startR = 150 + Math.random() * (Math.min(cx, cy) * 0.9);
        let px = cx + Math.cos(startAngle) * startR;
        let py = cy + Math.sin(startAngle) * startR;

        const points = [{ x: px, y: py }];
        const segs = 3 + Math.floor(Math.random() * 4);
        for (let s = 0; s < segs; s++) {
          px += (Math.random() - 0.5) * 60;
          py += (Math.random() - 0.5) * 60;
          points.push({ x: px, y: py });
        }

        sparks.push({
          x: px,
          y: py,
          vx: (Math.random() - 0.5) * 2,
          vy: (Math.random() - 0.5) * 2,
          life: 1,
          maxLife: 15 + Math.random() * 15,
          size: 1.5 + Math.random() * 2,
          color: colors[Math.floor(Math.random() * colors.length)],
          isLightning: true,
          points
        });
      }

      // Micro sparks burst
      for (let i = 0; i < 3; i++) {
        const angle = Math.random() * Math.PI * 2;
        const r = Math.random() * Math.min(cx, cy) * 0.95;
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r;
        const speed = 1 + Math.random() * 3.5;

        sparks.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 1,
          maxLife: 20 + Math.random() * 25,
          size: 1 + Math.random() * 2.2,
          color: colors[Math.floor(Math.random() * colors.length)]
        });
      }
    }

    function renderSparks() {
      if (!ctx || !sparksCanvas || !isRunning) return;
      ctx.clearRect(0, 0, sparksCanvas.width, sparksCanvas.height);

      emitBackgroundSparks();

      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i];
        s.x += s.vx;
        s.y += s.vy;
        s.life -= 1;

        if (s.life <= 0) {
          sparks.splice(i, 1);
          continue;
        }

        const alpha = s.life / s.maxLife;
        ctx.save();
        ctx.strokeStyle = s.color;
        ctx.fillStyle = s.color;
        ctx.globalAlpha = alpha;
        ctx.shadowColor = s.color;
        ctx.shadowBlur = 10;

        if (s.isLightning && s.points && s.points.length > 1) {
          ctx.lineWidth = s.size;
          ctx.beginPath();
          ctx.moveTo(s.points[0].x, s.points[0].y);
          for (let p = 1; p < s.points.length; p++) {
            ctx.lineTo(s.points[p].x + (Math.random() - 0.5) * 4, s.points[p].y + (Math.random() - 0.5) * 4);
          }
          ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      requestAnimationFrame(renderSparks);
    }
    requestAnimationFrame(renderSparks);

    // Boot Sequence Timing Logic (At least 3.2 seconds presentation)
    const logPhases = [
      { time: 0, text: 'INITIALIZING RLL-CORE V2.1 MATRIX...', voltage: 120 },
      { time: 450, text: 'ENERGIZING QUANTUM CIRCUIT TRACES...', voltage: 240 },
      { time: 1100, text: 'LOCKING HIGH-PRECISION CAD NODES...', voltage: 380 },
      { time: 1800, text: 'PROPAGATING ELECTROMAGNETIC SURGE...', voltage: 440 },
      { time: 2500, text: 'HARMONIC STABILIZATION CONFIRMED...', voltage: 480 },
      { time: 3000, text: 'SYSTEM ONLINE // ACCESS GRANTED.', voltage: 480 }
    ];

    const startTime = Date.now();
    const totalDuration = 3200; // 3.2 seconds minimum

    function update() {
      const elapsed = Date.now() - startTime;
      const progress = Math.min(100, (elapsed / totalDuration) * 100);

      if (progressBar) progressBar.style.width = `${progress}%`;
      if (pctText) pctText.textContent = `${String(Math.floor(progress)).padStart(3, '0')}%`;

      // Update telemetry stream text
      for (const phase of logPhases) {
        if (elapsed >= phase.time) {
          if (logText) logText.textContent = phase.text;
          if (voltText) voltText.textContent = `BUS VOLTAGE: ${(phase.voltage + Math.random() * 4).toFixed(1)} V`;
        }
      }

      if (elapsed < totalDuration) {
        requestAnimationFrame(update);
      } else {
        finishBoot();
      }
    }

    function finishBoot() {
      isRunning = false;
      sessionStorage.setItem('rll_intro_seen', 'true');
      overlay.classList.add('is-finished');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 800);
    }

    // Skip Handlers
    if (skipBtn) skipBtn.addEventListener('click', finishBoot);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter') {
        finishBoot();
      }
    });

    requestAnimationFrame(update);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runBootSequence);
  } else {
    runBootSequence();
  }
</script>
